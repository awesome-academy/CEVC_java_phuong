ENVIRONMENT=dev  # [Options: dev, prod]
DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password
LOG_PATH=foodapp/logs

# File upload settings
UPLOAD_FOLDER=uploads
APP_UPLOAD_LOCATION=/var/www/foodapp

# Replace <your-secret-key-here> with a secure random string for production.
# Example: openssl rand -base64 32
JWT_SECRET=<your-secret-key-here>

# Order notifications (#18). Leave a channel unset to skip it.
# Chatwork: API token (Chatwork > Service integration > API token) and the room id from the room URL (#!rid<id>)
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=
# Admin emails (new order, monthly report) go to every active ADMIN user.
# Local: docker compose up -d starts Mailpit (SMTP localhost:1025, inbox http://localhost:8025)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=foodapp@localhost
# Monthly report cron (Spring, 6 fields, Asia/Ho_Chi_Minh). Default: 08:00 on the 1st
# MONTHLY_REPORT_CRON=0 0 8 1 * *
